#include "resource.h"
#include <windows.h>

IDI_APPICON ICON "app.ico"

IDD_SETTINGS DIALOGEX 12, 12, 300, 456
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "SysHUD Settings"
FONT 8, "Segoe UI"
BEGIN
    GROUPBOX "Position", IDC_GRP_POSITION, 6, 4, 288, 56
    COMBOBOX IDC_POS_COMBO, 14, 20, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    LTEXT "X", -1, 130, 22, 12, 12
    EDITTEXT IDC_X_EDIT, 144, 19, 32, 14, ES_NUMBER
    LTEXT "Y", -1, 184, 22, 12, 12
    EDITTEXT IDC_Y_EDIT, 198, 19, 32, 14, ES_NUMBER
    LTEXT "Monitor", IDC_LBL_MONITOR, 14, 42, 42, 12
    COMBOBOX IDC_MONITOR_COMBO, 60, 40, 184, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    GROUPBOX "General", IDC_GRP_GENERAL, 6, 66, 288, 34
    LTEXT "Language", IDC_LBL_LANG, 14, 82, 38, 12
    COMBOBOX IDC_LANG_COMBO, 60, 80, 96, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    GROUPBOX "Appearance", IDC_GRP_APPEARANCE, 6, 106, 288, 64
    LTEXT "Opacity", IDC_LBL_OPACITY, 14, 124, 42, 12
    LTEXT "100", IDC_ALPHA_LABEL, 206, 124, 38, 12
    CONTROL "Border", IDC_CHK_BORDER, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 14, 144, 80, 12
    CONTROL "Topmost", IDC_CHK_TOPMOST, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 110, 144, 80, 12
    GROUPBOX "Interval", IDC_GRP_INTERVAL, 6, 176, 288, 28
    COMBOBOX IDC_INTERVAL_COMBO, 14, 186, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    GROUPBOX "Items", IDC_GRP_ITEMS, 6, 210, 288, 64
    CONTROL "CPU", IDC_CHK_CPU, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 14, 226, 54, 12
    CONTROL "MEM", IDC_CHK_MEM, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 74, 226, 54, 12
    CONTROL "GPU", IDC_CHK_GPU, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 134, 226, 54, 12
    CONTROL "NET", IDC_CHK_NET, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 194, 226, 54, 12
    CONTROL "Top3", IDC_CHK_TOP, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 14, 242, 54, 12
    CONTROL "Charts", IDC_CHK_CHARTS, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 74, 242, 54, 12
    LTEXT "TOP by", IDC_LBL_TOPBY, 14, 260, 40, 12
    COMBOBOX IDC_TOPBY_COMBO, 58, 258, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    LTEXT "Count", IDC_LBL_TOPCOUNT, 164, 260, 28, 12
    EDITTEXT IDC_TOPCOUNT_EDIT, 196, 258, 36, 14, ES_NUMBER
    GROUPBOX "GPU List", IDC_GRP_GPULIST, 6, 280, 288, 40
    LISTBOX IDC_GPU_LIST, 14, 294, 268, 24, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
    GROUPBOX "Quotes", IDC_GRP_QUOTES, 6, 326, 288, 70
    CONTROL "Show code quotes", IDC_CHK_QUOTES, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 14, 340, 110, 12
    LTEXT "Codes", IDC_LBL_QUOTE_CODES, 14, 358, 40, 12
    EDITTEXT IDC_QUOTE_CODES_EDIT, 58, 355, 224, 14, ES_AUTOHSCROLL
    LTEXT "Interval", IDC_LBL_QUOTE_INTERVAL, 14, 378, 42, 12
    COMBOBOX IDC_QUOTE_INTERVAL_COMBO, 60, 375, 110, 60, CBS_DROPDOWNLIST | WS_VSCROLL
    CONTROL "Autostart", IDC_CHK_AUTOSTART, "Button", BS_CHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 14, 404, 100, 12
    PUSHBUTTON "Apply", IDC_BTN_APPLY, 90, 426, 60, 18
    PUSHBUTTON "Reset", IDC_BTN_RESET, 156, 426, 60, 18
    DEFPUSHBUTTON "Close", IDC_BTN_CLOSE, 222, 426, 60, 18
END
